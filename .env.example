# EDebou — environnement runtime Next.js.
# Copier vers `.env.local`. Ce fichier contient uniquement les connexions
# runtime de moindre privilège et la sécurité checkout côté serveur. Ne jamais
# y placer un secret bootstrap/migration/seed.
DATABASE_URL=

# Connexion dédiée au checkout : ne jamais réutiliser le rôle de migration.
CHECKOUT_DATABASE_URL=

# Connexion dédiée au back-office authentifié.
ADMIN_DATABASE_URL=
PUBLIC_APP_ORIGIN=http://localhost:3000
ADMIN_APP_ORIGIN=http://localhost:3000

# Origines exactes séparées par des virgules, sans chemin (ex. production et
# développement). L'en-tête Origin est obligatoire pour POST /api/orders.
CHECKOUT_ALLOWED_ORIGINS=http://localhost:3000

# Secrets aléatoires distincts d'au moins 32 caractères, côté serveur seulement.
CHECKOUT_IDEMPOTENCY_PEPPER=
CHECKOUT_IP_HASH_PEPPER=

# 0 ignore tous les en-têtes proxy et applique un quota global conservateur en
# développement uniquement. La production refuse 0 : définir le nombre exact
# de proxies de confiance qui écrasent X-Forwarded-For ; l'adresse cliente est
# extraite depuis la droite.
CHECKOUT_TRUSTED_PROXY_HOPS=0

# Sécurité du back-office. Utiliser deux secrets aléatoires distincts d'au
# moins 32 caractères et le même nombre de proxies de confiance qu'en production.
ADMIN_SESSION_HASH_PEPPER=
ADMIN_IP_HASH_PEPPER=
ADMIN_TRUSTED_PROXY_HOPS=0
ADMIN_SESSION_TTL_HOURS=8

# Dossier persistant des images produits importées. En production self-hosted,
# le monter sur un volume sauvegardé. Une valeur relative part de la racine du projet.
PRODUCT_UPLOAD_DIR=storage/product-images
