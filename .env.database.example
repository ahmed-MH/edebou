# EDebou — opérations PostgreSQL locales uniquement.
# Copier vers `.env.database`. Next.js ne charge pas ce nom automatiquement.
# Ne jamais versionner `.env.database` ni réutiliser ces secrets en production.

POSTGRES_PORT=5432
POSTGRES_BOOTSTRAP_USER=edebou_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=
POSTGRES_DB=edebou
POSTGRES_MIGRATION_USER=edebou_migrate
POSTGRES_MIGRATION_PASSWORD=
POSTGRES_APP_USER=edebou_app
POSTGRES_APP_PASSWORD=
POSTGRES_CHECKOUT_USER=edebou_checkout
POSTGRES_CHECKOUT_PASSWORD=
POSTGRES_ADMIN_USER=edebou_admin
POSTGRES_ADMIN_PASSWORD=
POSTGRES_SHADOW_DB=edebou_shadow

# Utilisé par le contrôle d'intégration avec les droits runtime minimaux.
DATABASE_URL=

# Rôle d'écriture minimal utilisé uniquement par le checkout.
CHECKOUT_DATABASE_URL=

# Rôle d'administration dédié au back-office. Ne jamais réutiliser le rôle de
# migration ou le rôle public du catalogue.
ADMIN_DATABASE_URL=

# Utiliser le rôle de migration pour Prisma Migrate et la base shadow dédiée.
MIGRATION_DATABASE_URL=
SHADOW_DATABASE_URL=

# Le seed utilise le rôle de migration, reste local et exige le consentement
# ALLOW_DEMO_SEED=true. Le laisser désactivé par défaut.
SEED_DATABASE_URL=
NODE_ENV=development
ALLOW_DEMO_SEED=false

# Autorisation explicite pour le test checkout destructif limité à localhost.
ALLOW_CHECKOUT_DB_TEST=false
