{
  "name": "edebou",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "test:production": "node scripts/verify-production.mjs",
    "test:database": "node scripts/verify-database.mjs",
    "test:catalog-api": "node scripts/verify-catalog-api.mjs",
    "test:checkout-database": "node --conditions=react-server --import tsx scripts/verify-checkout-database.ts",
    "test:checkout-api": "node --conditions=react-server --import tsx scripts/verify-checkout-api.ts",
    "test:checkout-api:unavailable": "node --conditions=react-server --import tsx scripts/verify-checkout-api.ts --expect-unavailable",
    "test:product-images": "node --conditions=react-server --import tsx scripts/verify-product-images.ts",
    "oracle:env": "node scripts/generate-oracle-env.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:provision:checkout": "docker compose --env-file .env.database exec -T postgres /opt/edebou-admin/provision-checkout-role.sh",
    "db:provision:admin": "docker compose --env-file .env.database exec -T postgres /opt/edebou-admin/provision-admin-role.sh",
    "admin:create": "node --conditions=react-server --import tsx scripts/create-admin.ts",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:up": "docker compose --env-file .env.database up -d postgres",
    "db:stop": "docker compose --env-file .env.database stop postgres",
    "db:down": "docker compose --env-file .env.database down",
    "db:logs": "docker compose --env-file .env.database logs -f postgres"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.10",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "next-intl": "4.15.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "effect": "3.22.1"
  }
}
