# Generated values are intentionally examples. Do not deploy this file as-is.
PUBLIC_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
WWW_DOMAIN=www.example.com
PUBLIC_APP_ORIGIN=https://example.com
ADMIN_APP_ORIGIN=https://admin.example.com
ACME_EMAIL=admin@example.com
# Keep HSTS disabled until the first HTTPS deployment has been validated.
HSTS_MAX_AGE=0

POSTGRES_BOOTSTRAP_USER=edebou_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=replace_with_distinct_64_character_hex_secret_01
POSTGRES_DB=edebou
POSTGRES_SHADOW_DB=edebou_shadow
POSTGRES_MIGRATION_USER=edebou_migration
POSTGRES_MIGRATION_PASSWORD=replace_with_distinct_64_character_hex_secret_02
POSTGRES_APP_USER=edebou_catalog
POSTGRES_APP_PASSWORD=replace_with_distinct_64_character_hex_secret_03
POSTGRES_CHECKOUT_USER=edebou_checkout
POSTGRES_CHECKOUT_PASSWORD=replace_with_distinct_64_character_hex_secret_04
POSTGRES_ADMIN_USER=edebou_admin
POSTGRES_ADMIN_PASSWORD=replace_with_distinct_64_character_hex_secret_05

MIGRATION_DATABASE_URL=postgresql://edebou_migration:replace_with_distinct_64_character_hex_secret_02@postgres:5432/edebou?sslmode=disable
DATABASE_URL=postgresql://edebou_catalog:replace_with_distinct_64_character_hex_secret_03@postgres:5432/edebou?sslmode=disable
CHECKOUT_DATABASE_URL=postgresql://edebou_checkout:replace_with_distinct_64_character_hex_secret_04@postgres:5432/edebou?sslmode=disable
ADMIN_DATABASE_URL=postgresql://edebou_admin:replace_with_distinct_64_character_hex_secret_05@postgres:5432/edebou?sslmode=disable

CHECKOUT_ALLOWED_ORIGINS=https://example.com
CHECKOUT_IDEMPOTENCY_PEPPER=replace_with_distinct_64_character_hex_secret_06
CHECKOUT_IP_HASH_PEPPER=replace_with_distinct_64_character_hex_secret_07
ADMIN_SESSION_HASH_PEPPER=replace_with_distinct_64_character_hex_secret_08
ADMIN_IP_HASH_PEPPER=replace_with_distinct_64_character_hex_secret_09
ADMIN_SESSION_TTL_HOURS=8

# Meta Conversions API (optional). Secret token from Events Manager → Settings.
# Empty disables it. Set the test code only while testing, then clear it.
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# Conservative limits for the Oracle A1 target (2 OCPU / 12 GB RAM).
NODE_OPTIONS=--max-old-space-size=1536
APP_MEMORY_LIMIT=2g
APP_CPU_LIMIT=1.5
POSTGRES_MEMORY_LIMIT=3g
POSTGRES_CPU_LIMIT=1.5
POSTGRES_SHARED_BUFFERS=512MB
CADDY_MEMORY_LIMIT=512m
CADDY_CPU_LIMIT=0.5
